# RegLoop AI — Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# Never commit a .env file with real secrets.

# ── Backend ────────────────────────────────────────────────────────────────

# Database: SQLite (default for local dev), or PostgreSQL via Docker.
DATABASE_URL=sqlite+aiosqlite:///./regloop.db
SQLITE_DATABASE_URL=sqlite+aiosqlite:///./regloop.db

# PostgreSQL (used when running docker compose up)
# DATABASE_URL=postgresql+asyncpg://regloop:regloop@postgres:5432/regloop

# File storage
UPLOAD_DIR=./storage/uploads

# LLM provider: openai | anthropic | google
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# App runtime
APP_ENV=development
LOG_LEVEL=INFO

# ── Frontend ───────────────────────────────────────────────────────────────

# Public API base URL consumed by the Next.js frontend (must be NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
